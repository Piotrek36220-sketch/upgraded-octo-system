# Środowisko aplikacji: development, test lub production
APP_ENV=development

# Host i port serwera aplikacji
APP_HOST=127.0.0.1
APP_PORT=3000

# Poziom logowania: debug, info, warning lub error
LOG_LEVEL=info

# Uzupełnij tylko wtedy, gdy aplikacja będzie korzystać z bazy danych.
# DATABASE_URL=

# Nie przechowuj prawdziwych sekretów w tym pliku ani w repozytorium.
# APP_SECRET=
